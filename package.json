{
  "name": "@voxelkloud/wasm-core",
  "version": "0.2.0",
  "description": "Rust/wasm kernels for voxelkloud's LOD scheduler: frustum extraction, AABB classification and screen-space-error priority over the wasm linear memory.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "potree",
    "lidar",
    "wasm",
    "frustum",
    "lod",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/wasm-core.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./voxelkloud_wasm_core.wasm": "./dist/voxelkloud_wasm_core.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release && mkdir -p dist && cp target/wasm32-unknown-unknown/release/voxelkloud_wasm_core.wasm dist/",
    "build": "pnpm run build:wasm && tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@voxelkloud/view": "workspace:*",
    "@voxelkloud/loader": "workspace:*"
  }
}
